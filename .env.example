# Copia a .env y ajusta. Nunca subas .env al repositorio.
TUBIO_HOST=127.0.0.1
TUBIO_PORT=3095
TUBIO_BASE_URL=https://tubio.link
# openssl rand -base64 48
TUBIO_SECRET=
TUBIO_DATA_DIR=./data
# detrás de nginx: usa X-Forwarded-For para la IP (sólo se usa para el hash diario de visitantes)
TUBIO_TRUST_PROXY=1
# smtp://usuario:clave@host:587 — vacío = los correos quedan como .eml en data/mail/
TUBIO_SMTP_URL=
TUBIO_MAIL_FROM=tubio <no-reply@tubio.link>
TUBIO_MAX_UPLOAD_BYTES=10485760
# base geo opcional (DB-IP City Lite, CC-BY 4.0): data/geo/dbip-city-lite.mmdb
# TUBIO_GEO_DB=
TUBIO_SOURCE_URL=https://github.com/xmedook/tubio
# Login con Google (redirect autorizado: <TUBIO_BASE_URL>/login/google/callback)
TUBIO_GOOGLE_CLIENT_ID=
TUBIO_GOOGLE_CLIENT_SECRET=

# Datos legales (páginas /terms y /privacy)
TUBIO_LEGAL_OWNER=
TUBIO_LEGAL_ADDRESS=
TUBIO_PRIVACY_EMAIL=
TUBIO_CONTACT_EMAIL=
TUBIO_JURISDICTION=

# Recibos y transferencia
TUBIO_LEGAL_RFC=
TUBIO_BANK_NAME=
TUBIO_BANK_HOLDER=
TUBIO_BANK_CLABE=
TUBIO_BANK_ACCOUNT=
